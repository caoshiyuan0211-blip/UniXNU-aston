 // Processes of one user share immutable, version-keyed shader entries. A sandbox
 // that cannot write this directory continues with its container's cache.
+// 12R: the boot argument metal-cache-gen=N renames every shader cache directory with ".genN" (the shared one and each process's m2v):
+// a boot with a new N starts from empty caches and leaves the earlier ones as they are, unused. Empty without the argument.
+inline const char *shaderCacheGeneration() {
+    static const std::string suffix = []() -> std::string {
+        char args[1024] = {};
+        size_t size = sizeof args - 1;
+        if (sysctlbyname("kern.bootargs", args, &size, nullptr, 0) != 0) return {};
+        const char *at = strstr(args, "metal-cache-gen=");
+        return at ? ".gen" + std::to_string(atoi(at + 16)) : std::string();
+    }();
+    return suffix.c_str();
+}
