+    // 2D texture is refused at its draw by the type, a texture2d_ms read is served as such)
+    if (multisample && (info->stencil || info->blockW > 1 || desc.mipLevels != 1 || (desc.usage & ~kTextureUsageRead) != kTextureUsageRenderTarget)) {
