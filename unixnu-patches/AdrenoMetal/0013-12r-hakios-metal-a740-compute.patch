diff --git a/NativeHakiosA740Test.h b/NativeHakiosA740Test.h
new file mode 100644
index 0000000..5ece7dd
--- /dev/null
+++ b/NativeHakiosA740Test.h
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: MIT
+// Native Metal stage 4a on the OnePlus 12R's A740 (boot argument native-a740-fill=1, after the stage 1-3 tests): hakios-metal's own
+// driver (MIT, vendored as hakios-metal/: its command queue, command buffer and compute encoder, ported to a7xx) runs fill_id through
+// the NativeAdreno user client (hakios's Transport over the same calls as the tests above). One report row:
+//   N hk v<words right>/<1024> s<step> e<error> t<GPU microseconds> <hakios's refusal, if any>
+// Pass: v1024/1024 (every word holds gid * K + C, which only its own invocation writes).
+// Included from NativeA740FillTest.h (Gpu, streamText).
+#include <mach/mach_time.h>
+
+#include "hakios-metal/chip.hpp"
+#include "hakios-metal/command.hpp"
+#include "hakios-metal/native_adreno_transport.hpp"
+#include "hakios-metal/fill_id_a740.hpp"
+
+namespace {
+static void a740HakiosTest(unsigned port) {
+    void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_NOW | RTLD_LOCAL);
+    if (!iokit) return;
+    static Gpu gpu;   // the hakios device keeps calling through it
+    gpu.openFn = (IOServiceOpenFn)dlsym(iokit, "IOServiceOpen");
+    gpu.closeFn = (IOServiceCloseFn)dlsym(iokit, "IOServiceClose");
+    gpu.call = (CallFn)dlsym(iokit, "IOConnectCallStructMethod");
+    gpu.map = (MapFn)dlsym(iokit, "IOConnectMapMemory64");
+    gpu.unmap = (UnmapFn)dlsym(iokit, "IOConnectUnmapMemory64");
+    gpu.port = port;
+    if (!gpu.openFn || !gpu.closeFn || !gpu.call || !gpu.map || !gpu.unmap) return;
+    const int opened = gpu.openFn(port, mach_task_self(), 0x4147, &gpu.conn);
+    if (opened != 0 || !gpu.conn) {char t[64]; snprintf(t, sizeof t, "N hk open %x", unsigned(opened)); streamText(gpu, t); return;}
+    if (!gpu.probe() && !gpu.openMailbox()) {gpu.closeFn(gpu.conn); streamText(gpu, "N hk no channel"); return;}
+
+    namespace hm = hakios::metal;
+    static mach_timebase_info_data_t timebase;
+    mach_timebase_info(&timebase);
+    hm::NativeAdrenoCalls calls;
+    calls.method = [](uint32_t selector, const void *in, size_t inSize, void *out, size_t outSize) {
+        return gpu.method(selector, in, inSize, out, outSize);
+    };
+    calls.mapMemory = [](uint32_t token, uint64_t *address, uint64_t *length) {
+        // uncached, as the passing tests map their buffers (0x101: anywhere + inhibit cache)
+        return int(gpu.map(gpu.conn, token, mach_task_self(), address, length, 0x101));
+    };
+    calls.unmapMemory = [](uint32_t token, uint64_t address) { gpu.unmap(gpu.conn, token, mach_task_self(), address); };
+    calls.nowNs = []() { return int64_t(mach_continuous_time() * timebase.numer / timebase.denom); };
+
+    int step = 0;
+    unsigned right = 0;
+    int64_t gpuNs = 0;
+    std::string why;
+    hm::setTargetChip(hm::kChipA740);
+    auto transport = hm::openNativeAdreno(calls, &why);
+    if (transport) {
+        ++step;
+        hm::Gpu device(std::move(transport));
+        if (device.chipId() != hm::kChipA740) why = "chip " + std::to_string(device.chipId());
+        auto queue = why.empty() ? hm::CommandQueue::make(device, &why) : nullptr;
+        auto out = queue ? hm::newBuffer(device, 4096, &why) : nullptr;
+        if (queue && out) {
+            ++step;
+            for (unsigned i = 0; i < 1024; ++i) static_cast<volatile uint32_t *>(out->contents())[i] = 0x55555555;
+            const hm::Kernel &k = hm::kernels::fill_id_a740;
+            const uint32_t groups[3] = {16, 1, 1}, local[3] = {k.localSize[0], k.localSize[1], k.localSize[2]};
+            auto cb = queue->commandBuffer();
+            if (cb && cb->dispatch(k, groups, local, std::vector<hm::Binding>{{out.get(), 0}})) {
+                ++step;
+                cb->commit();
+                cb->waitUntilCompleted();
+                if (cb->status() == hm::CommandBuffer::kCompleted) ++step;
+                else why = cb->error().empty() ? "status " + std::to_string(int(cb->status())) : cb->error();
+                gpuNs = cb->gpuNanoseconds();
+                __asm__ volatile("dsb sy" ::: "memory");
+                const uint32_t K = 0x9e3779b1u, C = k.immediates[0];
+                for (unsigned gid = 0; gid < 1024; ++gid)
+                    if (static_cast<volatile uint32_t *>(out->contents())[gid] == gid * K + C) ++right;
+            } else if (cb) {
+                why = cb->error();
+            }
+        }
+    }
+    char text[64];
+    snprintf(text, sizeof text, "N hk v%u/1024 s%d t%lld %s", right, step, (long long)(gpuNs / 1000), why.c_str());
+    streamText(gpu, text);
+    gpu.mark(right == 1024 ? 0x6eff : 0x6efe);
+}
+}  // namespace
