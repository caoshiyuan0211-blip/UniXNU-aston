diff --git a/NativeA740FillTest.h b/NativeA740FillTest.h
new file mode 100644
index 0000000..00cec7c
--- /dev/null
+++ b/NativeA740FillTest.h
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: MIT
+// The first native compute dispatch on the A740 without Vulkan (OnePlus 12R, boot argument native-a740-fill=1): the command stream
+// of A740FillProgram.h (generated by the 12R port's 12r/metal/gen-a740-fill.cc from Mesa's computerator a7xx path, Mesa's a7xx
+// register definitions and the A740 device row) runs hakios-metal's fill_id kernel (MIT), assembled for chip 0x43050a01:
+// out[gid] = gid * 0x9E3779B1 + 0x1234 for 1024 invocations. Run by the probe daemon after the shared userspace test passed, on
+// its own connection; one report line (streamText, kept in the driver row of the adrenoprobed process):
+//   N fill v<words right>/<1024> c<control seqno> w<wait status> e<first error> s<step>
+// v1024 means the A740 ran a shader dispatched by our own PM4 and every invocation wrote the value only it could have written;
+// c1 means the CP reached the end-of-dispatch timestamp. Nothing here runs without the boot argument.
+#pragma once
+#include <sys/sysctl.h>
+#include "A740FillProgram.h"
+
+namespace {
+static bool a740FillWanted() {
+    char args[1024] = {};
+    size_t size = sizeof args - 1;
+    if (sysctlbyname("kern.bootargs", args, &size, nullptr, 0) != 0) return false;
+    return strstr(args, "native-a740-fill=1") != nullptr;
+}
+
+static void a740FillTest(unsigned port) {
+    void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_NOW | RTLD_LOCAL);
+    if (!iokit) return;
+    Gpu gpu;
+    gpu.openFn = (IOServiceOpenFn)dlsym(iokit, "IOServiceOpen");
+    gpu.closeFn = (IOServiceCloseFn)dlsym(iokit, "IOServiceClose");
+    gpu.call = (CallFn)dlsym(iokit, "IOConnectCallStructMethod");
+    gpu.map = (MapFn)dlsym(iokit, "IOConnectMapMemory64");
+    gpu.unmap = (UnmapFn)dlsym(iokit, "IOConnectUnmapMemory64");
+    gpu.port = port;
+    if (!gpu.openFn || !gpu.closeFn || !gpu.call || !gpu.map || !gpu.unmap) return;
+    gpu.mark(0x6c00);
+    if (gpu.openFn(port, mach_task_self(), 0x4147, &gpu.conn) != 0 || !gpu.conn) {gpu.mark(0x6c0e); return;}
+    if (!gpu.probe() && !gpu.openMailbox()) {gpu.closeFn(gpu.conn); gpu.mark(0x6c0f); return;}
+
+    int step = 0, error = 0, waitStatus = -1;
+    auto check = [&](int status) {
+        if (status && !error) error = status;
+        if (!status) ++step;
+        gpu.mark(0x6c00 | (step & 0xff));
+        return status == 0;
+    };
+    // Buffers, in this order: IB, shader, IBO descriptor, output buffer, control (the RB_DONE_TS seqno). Each one 4 KiB at its own
+    // page of a range the earlier tests did not use.
+    enum {kIb, kShader, kDesc, kBuffer, kControl, kCount};
+    static_assert(A740FillShader == 1 && A740FillBuffer == 2 && A740FillDesc == 3 && A740FillControl == 4, "relocation kinds");
+    uint64_t handle[kCount] = {}, iova[kCount] = {}, cpu[kCount] = {}, cpuLen[kCount] = {};
+    uint32_t token[kCount] = {};
+    NativeAdrenoAbiDeviceInfo info = {};
+    NativeAdrenoAbiParams params = {};
+    bool ready = check(gpu.method(NativeAdrenoMethodQuery, nullptr, 0, &params, sizeof params)) &&
+                 check(gpu.method(NativeAdrenoMethodGetDeviceInfo, nullptr, 0, &info, sizeof info));
+    if (ready && info.chip_id != 0x43050a01u) {error = 0xc41d; ready = false;}   // the stream is for this chip only
+    for (unsigned b = 0; b < kCount && ready; ++b) {
+        NativeAdrenoAbiBoAlloc alloc = {4096, 12, 0};
+        NativeAdrenoAbiBoAllocReply reply = {};
+        ready = check(gpu.method(NativeAdrenoMethodBoAlloc, &alloc, sizeof alloc, &reply, sizeof reply));
+        if (!ready) break;
+        handle[b] = reply.handle;
+        iova[b] = info.va_start + 0x200000 + b * 0x1000;
+        const uint32_t permissions = (b == kBuffer || b == kControl) ? 3 : 1;
+        NativeAdrenoAbiBoMap map = {handle[b], iova[b], permissions, 0, 2, 0};
+        NativeAdrenoAbiBoMapReply mapped = {};
+        NativeAdrenoAbiBoCpuMap cm = {handle[b]};
+        NativeAdrenoAbiBoCpuMapReply cr = {};
+        ready = check(gpu.method(NativeAdrenoMethodBoMap, &map, sizeof map, &mapped, sizeof mapped)) &&
+                check(gpu.method(NativeAdrenoMethodBoCpuMap, &cm, sizeof cm, &cr, sizeof cr)) &&
+                check(gpu.map(gpu.conn, cr.token, mach_task_self(), &cpu[b], &cpuLen[b], 0x101));
+        token[b] = cr.token;
+        if (ready && cpuLen[b] < 4096) {error = 0xbad1; ready = false;}
+    }
+    unsigned right = 0;
+    uint32_t seqno = 0xffffffffu;
+    if (ready) {
+        auto words = [&](unsigned b) {return reinterpret_cast<volatile uint32_t *>(cpu[b]);};
+        auto address = [&](unsigned kind, uint32_t offset) {
+            const unsigned b = kind == A740FillShader ? kShader : kind == A740FillBuffer ? kBuffer : kind == A740FillDesc ? kDesc : kControl;
+            return iova[b] + offset;
+        };
+        for (unsigned i = 0; i < sizeof kA740FillShader / 4; ++i) words(kShader)[i] = kA740FillShader[i];
+        for (unsigned i = 0; i < sizeof kA740FillDesc / 4; ++i) words(kDesc)[i] = kA740FillDesc[i];
+        for (const auto &r : kA740FillDescRelocs) {
+            const uint64_t a = address(r.kind, r.offset);
+            words(kDesc)[r.dword] = r.high ? uint32_t(a >> 32) : uint32_t(a);
+        }
+        for (unsigned i = 0; i < 1024; ++i) words(kBuffer)[i] = 0xdeadbeef;
+        for (unsigned i = 0; i < 1024; ++i) words(kControl)[i] = 0;
+        for (unsigned i = 0; i < sizeof kA740FillIb / 4; ++i) words(kIb)[i] = kA740FillIb[i];
+        for (const auto &r : kA740FillIbRelocs) {
+            const uint64_t a = address(r.kind, r.offset);
+            words(kIb)[r.dword] = r.high ? uint32_t(a >> 32) : uint32_t(a);
+        }
+        __asm__ volatile("dsb sy" ::: "memory");   // uncached mappings; the GPU is an outer-shareable observer
+        NativeAdrenoAbiSubmit submit = {};
+        submit.buffer_count = 1;
+        submit.buffers[0] = {handle[kIb], iova[kIb], sizeof kA740FillIb};
+        NativeAdrenoAbiSubmitReply sr = {};
+        if (check(gpu.method(NativeAdrenoMethodSubmit, &submit, sizeof submit, &sr, sizeof sr))) {
+            NativeAdrenoAbiWaitFence wait = {sr.fence, 1000000000ull};
+            waitStatus = gpu.method(NativeAdrenoMethodWaitFence, &wait, sizeof wait, nullptr, 0);
+            check(waitStatus);
+        }
+        __asm__ volatile("dsb sy" ::: "memory");
+        // Read even after a failed wait: how far the GPU got is the point of this test.
+        seqno = words(kControl)[0];
+        for (unsigned gid = 0; gid < A740_FILL_COUNT; ++gid)
+            if (words(kBuffer)[gid] == gid * A740_FILL_K + A740_FILL_C) ++right;
+    }
+    char text[64];
+    snprintf(text, sizeof text, "N fill v%u/%u c%x w%d e%x s%d", right, A740_FILL_COUNT, seqno, waitStatus, unsigned(error), step);
+    streamText(gpu, text);   // its own row: native_adreno_client_text["adrenoprobed"]
+    gpu.mark(right == A740_FILL_COUNT ? 0x6cff : 0x6cfe);
+    for (unsigned b = 0; b < kCount; ++b) {
+        if (!handle[b]) continue;
+        if (cpu[b]) {
+            gpu.unmap(gpu.conn, token[b], mach_task_self(), cpu[b]);
+            NativeAdrenoAbiBoCpuUnmap cu = {handle[b], token[b], 0};
+            gpu.method(NativeAdrenoMethodBoCpuUnmap, &cu, sizeof cu, nullptr, 0);
+        }
+        NativeAdrenoAbiBoFree f = {handle[b]};
+        gpu.method(NativeAdrenoMethodBoFree, &f, sizeof f, nullptr, 0);
+    }
+    gpu.closeFn(gpu.conn);
+}
+}  // namespace
diff --git a/NativeAdrenoProbeDaemon.cpp b/NativeAdrenoProbeDaemon.cpp
