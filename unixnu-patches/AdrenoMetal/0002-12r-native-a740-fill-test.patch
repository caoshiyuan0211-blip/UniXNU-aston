 // the driver's progress markers and SetMetadata.
 #include <stdlib.h>
 #include "NativeAdrenoUserTest.h"
+#include "NativeA740FillTest.h"
 
 extern "C" void nativeOsLogExport();
 
@@ -23,7 +24,10 @@ int main() {
         port = getService(0, matching("IOAcceleratorES"));
         if (!port) usleep(500000);
     }
-    const int status = !port ? 3 : adrenoUserTest(port, "adrenoprobed") >= 0 ? 0 : 4;
+    const int verified = port ? adrenoUserTest(port, "adrenoprobed") : -1;
+    const int status = !port ? 3 : verified >= 0 ? 0 : 4;
+    // 12R: the first native (no Vulkan) compute dispatch, only with native-a740-fill=1 and after the basic GPU path verified.
+    if (port && verified == 4 && a740FillWanted()) a740FillTest(port);
     nativeOsLogExport();
     return status;
 }
