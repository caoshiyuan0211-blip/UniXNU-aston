diff --git a/NativeA740FillTest.h b/NativeA740FillTest.h
index 00cec7c..2aa2301 100644
--- a/NativeA740FillTest.h
+++ b/NativeA740FillTest.h
@@ -2,8 +2,8 @@
 // The first native compute dispatch on the A740 without Vulkan (OnePlus 12R, boot argument native-a740-fill=1): the command stream
 // of A740FillProgram.h (generated by the 12R port's 12r/metal/gen-a740-fill.cc from Mesa's computerator a7xx path, Mesa's a7xx
 // register definitions and the A740 device row) runs hakios-metal's fill_id kernel (MIT), assembled for chip 0x43050a01:
-// out[gid] = gid * 0x9E3779B1 + 0x1234 for 1024 invocations. Run by the probe daemon after the shared userspace test passed, on
-// its own connection; one report line (streamText, kept in the driver row of the adrenoprobed process):
+// out[gid] = gid * 0x9E3779B1 + 0x1234 for 1024 invocations. Run after the shared userspace test passed (by the Metal plug-in, once per boot
+// outside the render server, and by the probe daemon where a build ships it), on its own connection; one report line (streamText, kept in the driver row of the adrenoprobed process):
 //   N fill v<words right>/<1024> c<control seqno> w<wait status> e<first error> s<step>
 // v1024 means the A740 ran a shader dispatched by our own PM4 and every invocation wrote the value only it could have written;
 // c1 means the CP reached the end-of-dispatch timestamp. Nothing here runs without the boot argument.
@@ -31,8 +31,10 @@ static void a740FillTest(unsigned port) {
     gpu.port = port;
     if (!gpu.openFn || !gpu.closeFn || !gpu.call || !gpu.map || !gpu.unmap) return;
     gpu.mark(0x6c00);
-    if (gpu.openFn(port, mach_task_self(), 0x4147, &gpu.conn) != 0 || !gpu.conn) {gpu.mark(0x6c0e); return;}
-    if (!gpu.probe() && !gpu.openMailbox()) {gpu.closeFn(gpu.conn); gpu.mark(0x6c0f); return;}
+    // The report stream needs no connection (markers are refused opens), so a failure to connect is reported too.
+    const int opened = gpu.openFn(port, mach_task_self(), 0x4147, &gpu.conn);
+    if (opened != 0 || !gpu.conn) {char t[64]; snprintf(t, sizeof t, "N fill open %x", unsigned(opened)); streamText(gpu, t); return;}
+    if (!gpu.probe() && !gpu.openMailbox()) {gpu.closeFn(gpu.conn); streamText(gpu, "N fill no channel"); return;}
 
     int step = 0, error = 0, waitStatus = -1;
     auto check = [&](int status) {
