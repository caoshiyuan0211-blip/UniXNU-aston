index 0000000..83d3f3b
--- /dev/null
+++ b/NativeA740TriTest.h
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: MIT
+// Native Metal stage 2a on the OnePlus 12R's A740 (boot argument native-a740-fill=1, after the compute fill test): one flat command
+// stream (A740TriProgram.h, generated by the 12R port's 12r/metal/gen-a740-tri.py from Turnip's recorded a7xx submission of the same
+// smoke test, flattened for one sysmem pass on the BR thread) clears a 64x64 RGBA8 LINEAR target to blue and draws one orange
+// triangle, without Vulkan or Turnip. One report line (streamText, the process's own row):
+//   N f<compute words right> tri o<orange> b<blue> x<other> c<control seqno> w<wait status> e<first error> s<step>
+// Turnip's own pass criterion for this triangle is 480..544 orange pixels and no pixel of another colour.
+// Included from NativeA740FillTest.h (the Gpu helpers and streamText come from NativeAdrenoUserTest.h).
+
+namespace {
+static void a740TriTest(unsigned port, unsigned fillRight) {   // fillRight: stage 1's result, kept in the same report row
+    void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_NOW | RTLD_LOCAL);
+    if (!iokit) return;
+    Gpu gpu;
+    gpu.openFn = (IOServiceOpenFn)dlsym(iokit, "IOServiceOpen");
+    gpu.closeFn = (IOServiceCloseFn)dlsym(iokit, "IOServiceClose");
+    gpu.call = (CallFn)dlsym(iokit, "IOConnectCallStructMethod");
+    gpu.map = (MapFn)dlsym(iokit, "IOConnectMapMemory64");
+    gpu.unmap = (UnmapFn)dlsym(iokit, "IOConnectUnmapMemory64");
+    gpu.port = port;
+    if (!gpu.openFn || !gpu.closeFn || !gpu.call || !gpu.map || !gpu.unmap) return;
+    gpu.mark(0x6d00);
+    const int opened = gpu.openFn(port, mach_task_self(), 0x4147, &gpu.conn);
+    if (opened != 0 || !gpu.conn) {char t[64]; snprintf(t, sizeof t, "N tri open %x", unsigned(opened)); streamText(gpu, t); return;}
+    if (!gpu.probe() && !gpu.openMailbox()) {gpu.closeFn(gpu.conn); streamText(gpu, "N tri no channel"); return;}
+
+    int step = 0, error = 0, waitStatus = -1;
+    auto check = [&](int status) {
+        if (status && !error) error = status;
+        if (!status) ++step;
+        gpu.mark(0x6d00 | (step & 0xff));
+        return status == 0;
+    };
+    // Buffers: IB, program (VS + its constant buffer, FS), colour target, border colours, control (the RB_DONE_TS seqno).
+    enum {kIb, kProgram, kTarget, kBorder, kControl, kCount};
+    static_assert(A740_TRI_SIZE * A740_TRI_SIZE * 4 <= 16384, "target");
+    static const uint64_t kBytes[kCount] = {8192, 4096, 16384, 4096, 4096};
+    uint64_t handle[kCount] = {}, iova[kCount] = {}, cpu[kCount] = {}, cpuLen[kCount] = {};
+    uint32_t token[kCount] = {};
+    NativeAdrenoAbiDeviceInfo info = {};
+    NativeAdrenoAbiParams params = {};
+    bool ready = check(gpu.method(NativeAdrenoMethodQuery, nullptr, 0, &params, sizeof params)) &&
+                 check(gpu.method(NativeAdrenoMethodGetDeviceInfo, nullptr, 0, &info, sizeof info));
+    if (ready && info.chip_id != 0x43050a01u) {error = 0xc41d; ready = false;}
+    uint64_t next = info.va_start + 0x400000;   // clear of the fill test's 0x200000.. pages
+    for (unsigned b = 0; b < kCount && ready; ++b) {
+        NativeAdrenoAbiBoAlloc alloc = {kBytes[b], 12, 0};
+        NativeAdrenoAbiBoAllocReply reply = {};
+        ready = check(gpu.method(NativeAdrenoMethodBoAlloc, &alloc, sizeof alloc, &reply, sizeof reply));
+        if (!ready) break;
+        handle[b] = reply.handle;
+        iova[b] = next;
+        next += kBytes[b];
+        const uint32_t permissions = (b == kTarget || b == kControl) ? 3 : 1;
+        NativeAdrenoAbiBoMap map = {handle[b], iova[b], permissions, 0, 2, 0};
+        NativeAdrenoAbiBoMapReply mapped = {};
+        NativeAdrenoAbiBoCpuMap cm = {handle[b]};
+        NativeAdrenoAbiBoCpuMapReply cr = {};
+        ready = check(gpu.method(NativeAdrenoMethodBoMap, &map, sizeof map, &mapped, sizeof mapped)) &&
+                check(gpu.method(NativeAdrenoMethodBoCpuMap, &cm, sizeof cm, &cr, sizeof cr)) &&
+                check(gpu.map(gpu.conn, cr.token, mach_task_self(), &cpu[b], &cpuLen[b], 0x101));
+        token[b] = cr.token;
+        if (ready && cpuLen[b] < kBytes[b]) {error = 0xbad1; ready = false;}
+    }
+    unsigned orange = 0, blue = 0, other = 0;
+    uint32_t seqno = 0xffffffffu;
+    if (ready) {
+        auto words = [&](unsigned b) {return reinterpret_cast<volatile uint32_t *>(cpu[b]);};
+        for (unsigned i = 0; i < sizeof kA740TriProgram / 4; ++i) words(kProgram)[i] = kA740TriProgram[i];
+        for (unsigned i = 0; i < A740_TRI_SIZE * A740_TRI_SIZE; ++i) words(kTarget)[i] = 0x55555555;   // untouched pixels show as other
+        for (unsigned i = 0; i < 1024; ++i) words(kBorder)[i] = 0;
+        for (unsigned i = 0; i < 1024; ++i) words(kControl)[i] = 0;
+        for (unsigned i = 0; i < sizeof kA740TriIb / 4; ++i) words(kIb)[i] = kA740TriIb[i];
+        for (const auto &r : kA740TriRelocs) {
+            const unsigned kind = r.kind & 0x7f;
+            const unsigned b = kind == 1 ? kProgram : kind == 2 ? kTarget : kind == 3 ? kBorder : kControl;
+            const uint64_t a = iova[b] + r.offset;
+            if (r.kind & 0x80) words(kIb)[r.dword] = words(kIb)[r.dword] | uint32_t((a >> 32) & 0x1ffff);   // UBO descriptor: size above
+            else words(kIb)[r.dword] = r.high ? uint32_t(a >> 32) : uint32_t(a);
+        }
+        __asm__ volatile("dsb sy" ::: "memory");
+        NativeAdrenoAbiSubmit submit = {};
+        submit.buffer_count = 1;
+        submit.buffers[0] = {handle[kIb], iova[kIb], sizeof kA740TriIb};
+        NativeAdrenoAbiSubmitReply sr = {};
+        if (check(gpu.method(NativeAdrenoMethodSubmit, &submit, sizeof submit, &sr, sizeof sr))) {
+            NativeAdrenoAbiWaitFence wait = {sr.fence, 1000000000ull};
+            waitStatus = gpu.method(NativeAdrenoMethodWaitFence, &wait, sizeof wait, nullptr, 0);
+            check(waitStatus);
+        }
+        __asm__ volatile("dsb sy" ::: "memory");
+        seqno = words(kControl)[0];
+        for (unsigned i = 0; i < A740_TRI_SIZE * A740_TRI_SIZE; ++i) {
+            const uint32_t p = words(kTarget)[i];
+            if (p == A740_TRI_CLEAR) ++blue;
+            else if ((p & 0xff00ffffu) == 0xff0000ffu && ((p >> 8) & 0xff) >= 0x7f && ((p >> 8) & 0xff) <= 0x80) ++orange;
+            else ++other;
+        }
+    }
+    char text[64];
+    snprintf(text, sizeof text, "N f%u tri o%u b%u x%u c%x w%d e%x s%d", fillRight, orange, blue, other, seqno, waitStatus, unsigned(error), step);
+    streamText(gpu, text);
+    gpu.mark(orange >= 480 && orange <= 544 && other == 0 ? 0x6dff : 0x6dfe);
+    for (unsigned b = 0; b < kCount; ++b) {
+        if (!handle[b]) continue;
+        if (cpu[b]) {
+            gpu.unmap(gpu.conn, token[b], mach_task_self(), cpu[b]);
+            NativeAdrenoAbiBoCpuUnmap cu = {handle[b], token[b], 0};
+            gpu.method(NativeAdrenoMethodBoCpuUnmap, &cu, sizeof cu, nullptr, 0);
+        }
+        NativeAdrenoAbiBoFree f = {handle[b]};
+        gpu.method(NativeAdrenoMethodBoFree, &f, sizeof f, nullptr, 0);
+    }
+    gpu.closeFn(gpu.conn);
+}
+}  // namespace
