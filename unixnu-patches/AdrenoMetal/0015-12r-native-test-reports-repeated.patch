 namespace {
+// One report row, ended with " #xx" (the sum of its bytes before the mark, mod 256): the kernel keeps one text per process and the log
+// copies it every 2 s, so a row written while it is being copied comes out torn (12R boot 32: two rows interleaved). REPEAT copies,
+// 3 s apart, so a clean one is in the log, also after the process's own Turnip messages have replaced it.
+static void hakiosReport(Gpu &gpu, const char *text, int repeat) {
+    char row[64];
+    unsigned sum = 0;
+    for (const char *c = text; *c; ++c) sum += uint8_t(*c);
+    snprintf(row, sizeof row, "%.58s #%02x", text, sum & 0xff);
+    for (int i = 0; i < repeat; ++i) {
+        streamText(gpu, row);
+        if (i + 1 < repeat) sleep(3);
+    }
+}
