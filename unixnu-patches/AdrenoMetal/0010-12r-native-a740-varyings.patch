diff --git a/NativeA740TriTest.h b/NativeA740TriTest.h
index 6f2b97c..c0dd164 100644
--- a/NativeA740TriTest.h
+++ b/NativeA740TriTest.h
@@ -65,7 +65,8 @@ static void a740TriTest(unsigned port, unsigned fillRight) {   // fillRight: sta
         if (ready && cpuLen[b] < kBytes[b]) {error = 0xbad1; ready = false;}
     }
     unsigned orange = 0, blue = 0, other = 0;
-    uint32_t centre = 0, firstOther = 0;   // the colour actually written: the centre pixel and the first pixel neither orange nor blue
+    uint32_t centre = 0, firstOther = 0;
+    unsigned maxError = 0;   // stage 3a: the largest channel difference to the reference   // the colour actually written: the centre pixel and the first pixel neither orange nor blue
     uint32_t seqno = 0xffffffffu;
     if (ready) {
         auto words = [&](unsigned b) {return reinterpret_cast<volatile uint32_t *>(cpu[b]);};
@@ -99,6 +100,35 @@ static void a740TriTest(unsigned port, unsigned fillRight) {   // fillRight: sta
             for (unsigned c = 0; c < 32; c += 8) {const int d = int((a >> c) & 0xff) - int((b >> c) & 0xff); if (d < -1 || d > 1) return false;}
             return true;
         };
+#ifdef A740_TRI_GRADIENT
+        (void)near;
+        // Stage 3a: every drawn pixel against the colour interpolated at its centre (barycentrics of the window-space triangle; the
+        // viewport maps clip x, y in [-1, 1] to [0, W] x [0, H]); within 3 steps per channel.
+        float wx[3], wy[3];
+        for (int v = 0; v < 3; ++v) {wx[v] = (kA740TriPos[v][0] * 0.5f + 0.5f) * A740_TRI_W; wy[v] = (kA740TriPos[v][1] * 0.5f + 0.5f) * A740_TRI_H;}
+        auto edge = [&](int a, int b, float px, float py) {return (wx[b] - wx[a]) * (py - wy[a]) - (wy[b] - wy[a]) * (px - wx[a]);};
+        const float area = edge(0, 1, wx[2], wy[2]);
+        for (unsigned y = 0; y < A740_TRI_H; ++y)
+            for (unsigned x = 0; x < A740_TRI_W; ++x) {
+                const uint32_t p = words(kTarget)[y * (A740_TRI_PITCH / 4) + x];
+                if (p == A740_TRI_CLEAR) {++blue; continue;}
+                const float cx = x + 0.5f, cy = y + 0.5f;
+                const float l0 = edge(1, 2, cx, cy) / area, l1 = edge(2, 0, cx, cy) / area, l2 = 1.0f - l0 - l1;
+                uint32_t want = 0;
+                int worst = 0;
+                for (int c = 0; c < 4; ++c) {
+                    float f = l0 * kA740TriRgba[0][c] + l1 * kA740TriRgba[1][c] + l2 * kA740TriRgba[2][c];
+                    f = f < 0 ? 0 : f > 1 ? 1 : f;
+                    const int e = int(f * 255.0f + 0.5f), got = int((p >> (8 * c)) & 0xff), d = e > got ? e - got : got - e;
+                    want |= uint32_t(e) << (8 * c);
+                    if (d > worst) worst = d;
+                }
+                if (worst > int(maxError)) maxError = unsigned(worst);
+                if (worst <= 3) ++orange;
+                else {if (!other) {firstOther = p; centre = want;} ++other;}
+            }
+        if (!other) centre = words(kTarget)[(A740_TRI_H / 2) * (A740_TRI_PITCH / 4) + A740_TRI_W / 2];
+#else
         for (unsigned y = 0; y < A740_TRI_H; ++y)
             for (unsigned x = 0; x < A740_TRI_W; ++x) {
                 const uint32_t p = words(kTarget)[y * (A740_TRI_PITCH / 4) + x];
@@ -106,9 +136,16 @@ static void a740TriTest(unsigned port, unsigned fillRight) {   // fillRight: sta
                 else if (near(p, A740_TRI_COLOR)) ++orange;
                 else {if (!other) firstOther = p; ++other;}
             }
+#endif
     }
     char text[64];
+    #ifdef A740_TRI_GRADIENT
+    // g: o matched pixels, b background, x mismatched, m largest channel error, q first mismatch and p what it should have been
+    snprintf(text, sizeof text, "N f%u g o%u b%u x%u m%u q%x p%x c%x w%d e%x", fillRight, orange, blue, other, maxError, firstOther, centre,
+             seqno, waitStatus, unsigned(error));
+#else
     snprintf(text, sizeof text, "N f%u t o%u b%u x%u p%x q%x c%x w%d e%x", fillRight, orange, blue, other, centre, firstOther, seqno, waitStatus, unsigned(error));
+#endif
     streamText(gpu, text);
     const unsigned slack = (A740_TRI_W + A740_TRI_H) / 2;   // edge pixels
     gpu.mark(orange + slack >= A740_TRI_AREA && orange <= A740_TRI_AREA + slack && other == 0 ? 0x6dff : 0x6dfe);
